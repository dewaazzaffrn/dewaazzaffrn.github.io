---
interface Project {
  title: string;
  image: string;
  preview: string;
  description: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "GetWebify",
    image: "/projects/1.png",
    preview: "https://www.getwebify.web.id/",
    description: "Web Development Service",
    status: "Deployed",
  },
  {
    title: "Sigubla",
    image: "/projects/3.png",
    preview: "https://sigubla.getwebify.web.id/",
    description: "Batik MSME Mapping (GIS)",
    status: "Deployed",
  },
  {
    title: "Need a Job",
    image: "/projects/2.png",
    preview: "https://needajob.web.id/",
    description: "Job Application Platform",
    status: "Deployed",
  },
  {
    title: "Kaensa Bucket",
    image: "/projects/4.png",
    preview: "https://kaensabucket.getwebify.web.id/",
    description: "Flower Bouquet Shop",
    status: "in Development",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="group">
            <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
              <a
                href={project.preview}
                target="_blank"
                rel="noopener noreferrer"
                class="block"
              >
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-40 md:h-64 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </a>
            </div>

            <div class="flex items-center px-3">
              <div class="flex-grow">
                <h4 class="text-2xl font-semibold">
                  {project.title}
                </h4>

                <p class="text-base text-[var(--white-icon)]">
                  {project.description}
                </p>

                <span class="text-sm text-[var(--white-icon)]">
                  {project.status}
                </span>
              </div>

              <a
                target="_blank"
                rel="noopener noreferrer"
                href={project.preview}
                aria-label={`Preview ${project.title}`}
                class="size-14 flex-shrink-0 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-7"
                >
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <a
      target="_blank"
      href="https://github.com/dewaazzaffrn"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">More projects on</span>

      <!-- GitHub SVG tetap seperti kode kamu -->
    </a>
  </div>
</section>
